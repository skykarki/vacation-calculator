generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())

  trips    Trip[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Trip {
  id          String   @id @default(cuid())
  title       String
  destination String
  startDate   DateTime
  endDate     DateTime
  totalDays   Int
  notes       String?
  packingList Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itinerary ItineraryItem[]
  expenses  Expense[]
  bookings  Booking[]
  documents Document[]

  @@index([userId, startDate])
}

model ItineraryItem {
  id    String  @id @default(cuid())
  day   Int
  title String
  time  String?
  notes String?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, day])
}

model Expense {
  id       String  @id @default(cuid())
  category String
  amount   Float
  currency String  @default("USD")
  note     String?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Booking {
  id            String    @id @default(cuid())
  type          String
  provider      String
  confirmation  String?
  origin        String?
  destination   String?
  flightNumber  String?
  cabin         String?
  price         Float?
  currency      String    @default("USD")
  passengerName String?
  passengers    Int       @default(1)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileName  String
  mimeType  String
  filePath  String
  createdAt DateTime @default(now())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
