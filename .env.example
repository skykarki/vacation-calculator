DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/travel_app?sslmode=require"
AUTH_SECRET="generate with: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Deployment (Vercel + Neon/Supabase)
# DATABASE_URL  hosted Postgres connection string (keep ?sslmode=require)
# AUTH_SECRET   long random string (npx auth secret)
# AUTH_URL      your public URL, e.g. https://vacation-calculator.vercel.app
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET  optional Google sign-in
